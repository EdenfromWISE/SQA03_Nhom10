# Copy file này thành .env và sửa cho phù hợp môi trường
# URL FE và BE
FE_BASE_URL=http://localhost:5173
BE_BASE_URL=http://127.0.0.1:8000

# MySQL (đồng bộ với E-Vocab/.env)
DB_NAME=django_vocab
DB_USER=root
DB_PASSWORD=11092004
DB_HOST=localhost
DB_PORT=3306

# Tài khoản chuẩn để chạy test
# Test user thường (đã verify) cho LOG-ST-01
TEST_USER_EMAIL=sysauto_user@test.local
TEST_USER_PASSWORD=Abc@12345
# Tài khoản superuser cho UM-ST-01
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Tài khoản user thường (is_staff=False) cho UM-ST-02
# Project dùng email làm username -> để nguyên email
NON_STAFF_USERNAME=sysauto_user@test.local
NON_STAFF_PASSWORD=Abc@12345

# Topic dùng để test flashcard / search (lấy 1 topic_id có sẵn trong DB)
TEST_TOPIC_ID=1

# Cấu hình driver: auto = tự dò Chrome trước, fallback Edge
HEADLESS=0
BROWSER=auto
